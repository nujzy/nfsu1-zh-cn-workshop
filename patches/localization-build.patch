+                texture_id = ea_hash(name)
+                out[record + 0x0C:record + 0x24] = name.encode('ascii')[:24].ljust(24, b'\0')
+                struct.pack_into('<I', out, HASH_LIST + index * 8, texture_id)
+                struct.pack_into('<I', out, record + 0x24, texture_id)
+            struct.pack_into('<IHHBBB', out, record + 0x40, width * height, width, height,
+                             width.bit_length() - 1, height.bit_length() - 1, DXT5)
+            out[record + 0x4E] = levels
+            out[fmt + 0x14:fmt + 0x18] = b'DXT5'
+            print(f'{texture_id:08x}: {width}x{height}, {levels} mips, {raw_size} decoded bytes')
+
+        output_ids.append(texture_id)
+        struct.pack_into('<5I', out, DIRECTORY + index * 0x14, texture_id, len(out), len(blob), flags, pad)
+        cache_end = (cache_offset + raw_size + 0x7F) & ~0x7F
+        struct.pack_into('<3I', out, record + 0x30, cache_offset, cache_end, raw_size)
+        cache_offset = cache_end
+        out.extend(blob)
+
+    if output_ids != sorted(set(output_ids)):
+        raise ValueError('renamed texture IDs would break the sorted TPK index')
+    struct.pack_into('<I', out, 0x784, len(out) - 0x788)
+    struct.pack_into('<I', out, 0x704, len(out) - 0x708)
+    out.extend(template[-0x1008:])
+    struct.pack_into('<I', out, 4, len(out) - 0x1010)
+    return out
+
+
+def main():
+    template = Path(paths.lang_template()).read_bytes()
+    data = patch_tpk(template, keep_names=os.environ.get('TPK_MODE') == 'keep')
+    target = Path(paths.OUT) / 'LANGUAGETEXTURES.BIN'
+    target.parent.mkdir(parents=True, exist_ok=True)
+    target.write_bytes(data)
+
+
+if __name__ == '__main__':
+    main()
