+def patch_tpk(template, keep_names):
+    count = struct.unpack_from('<I', template, DIRECTORY - 4)[0] // 0x14
+    if count != 8 or struct.unpack_from('<II', template, FORMATS - 8) != (0x33310005, count * 32):
+        raise ValueError('expected an Underground language TPK with eight textures')
+    entries = list(struct.unpack_from('<5I', template, DIRECTORY + i * 0x14) for i in range(count))
+    if not FONT_FACES.keys() <= {entry[0] for entry in entries}:
+        raise ValueError('original TPK is missing its Korean font textures')
+
+    out = bytearray(template[:PAYLOAD])
+    cache_offset = 0
+    output_ids = []
+    for index, (texture_id, offset, size, flags, pad) in enumerate(entries):
+        record = DESCRIPTORS + index * 0x7C
+        fmt = FORMATS + index * 32
+        blob = template[offset:offset + size]
+        if offset < PAYLOAD or len(blob) != size or blob[:4] != b'JDLZ':
+            raise ValueError(f'{texture_id:08x}: invalid texture payload')
+        raw_size = struct.unpack_from('<I', blob, 8)[0]
+        if texture_id in FONT_FACES:
+            face = FONT_FACES[texture_id]
+            stock_dimensions = struct.unpack_from('<HH', template, record + 0x44)
+            pixels, width, height, levels = read_page(face, stock_dimensions)
+            blob = compress(pixels)
+            raw_size = len(pixels)
+            if not keep_names:
