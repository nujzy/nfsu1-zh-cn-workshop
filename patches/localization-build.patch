+    levels = min(width, height).bit_length() - 3
+    expected_size = sum((width >> level) * (height >> level) for level in range(levels))
+    if len(pixels) != expected_size:
+        raise ValueError(f'page{face}: {len(pixels)} bytes for {width}x{height}, expected {expected_size}')
+    return pixels, width, height, levels
